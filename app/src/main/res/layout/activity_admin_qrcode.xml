<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF"
    tools:context=".AdminQrcode">


    <!-- Top Header -->

    <LinearLayout
        android:layout_width="395dp"
        android:layout_height="720dp"
        android:gravity="center"
        android:orientation="vertical">

    </LinearLayout>


    <!-- Card Container -->

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="660dp"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="680dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">


            <!-- Vehicle ID Input -->


            <!-- Generate Button -->


            <!-- QR Code Preview -->

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:srcCompat="@drawable/outline_admin_panel_settings_24" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin QR Generator"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="#02022A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:text="Generate QR for vehicle tracking"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etData"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:maxLength="10"
                android:background="@drawable/input_bg"
                android:hint="Enter Vehicle ID"
                android:textAlignment="center" />

            <Button
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#0A1F44"
                android:text="Generate QR Code"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/input_bg" />


            <!-- Status Text -->

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: Waiting..."
                android:textColor="#555555"
                android:textSize="15sp" />


            <!-- Map Button -->

            <Button
                android:id="@+id/btnGoToMap"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0A1F44"
                android:text="Go to Tracking Map"
                android:textColor="@android:color/white"
                android:textStyle="bold" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
