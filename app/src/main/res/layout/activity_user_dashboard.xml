<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#01011F"
    tools:context=".UserDashboardActivity">


    <!-- Top Header Background -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="184dp"
        android:padding="0dp">

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="448dp"
            android:layout_height="192dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/darkblue_car" />
    </LinearLayout>


    <!-- Dashboard Card -->

    <androidx.cardview.widget.CardView
        android:layout_width="330dp"
        android:layout_height="450dp"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:layout_marginBottom="35dp"
        android:layout_marginTop="155dp"
        android:layout_centerHorizontal="true"
        android:padding="20dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="10dp">


        <LinearLayout
            android:layout_width="331dp"
            android:layout_height="498dp"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">


            <!-- Status Icon -->

            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/location_sharing" />


            <!-- Tracking Status -->

            <TextView
                android:id="@+id/tvTrackingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Tracking Active"
                android:textColor="#0A1F44"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- Description Text -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your live location is being shared with the admin."
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="10sp" />


            <!-- Stop Tracking Button #0A1F44-->

            <Button
                android:id="@+id/btnStopTracking"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0A1F44"
                android:text="Stop Sharing Location"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartTracking"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:text="Start Sharing Location"
                android:layout_marginTop="5dp"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:backgroundTint="#0A1F44 "
                android:textStyle="bold"/>


            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="top|center"
                android:layout_marginTop="3dp"
                android:backgroundTint="#03A9F4"
                android:contentDescription="Logout"
                android:elevation="8dp"
                android:tint="@color/white"
                android:src="@android:drawable/ic_lock_power_off" />


        </LinearLayout>


    </androidx.cardview.widget.CardView>



</RelativeLayout>
