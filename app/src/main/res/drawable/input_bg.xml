<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

        <!-- Background color -->
        <solid android:color="#FFFFFF"/>

        <!-- Rounded corners -->
        <corners android:radius="12dp"/>

        <!-- Border -->
        <stroke
            android:width="1.5dp"
            android:color="#0A1F44"/>

        <!-- Padding inside textbox -->
        <padding
            android:left="12dp"
            android:right="12dp"
            android:top="10dp"
            android:bottom="10dp"/>
</shape>